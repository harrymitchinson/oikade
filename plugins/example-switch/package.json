{
  "name": "@harrymitchinson/oikade-plugin-example-switch",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A simulated relay plugin that exercises the oikade/v1 contract without hardware",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@harrymitchinson/oikade-plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  }
}
