{
  "name": "@harrymitchinson/oikade-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "The TypeScript plugin SDK and the plugins built with it",
  "license": "Apache-2.0",
  "workspaces": [
    "sdk/typescript",
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "build": "yarn workspaces foreach -A --topological-dev --exclude @harrymitchinson/oikade-workspace run build",
    "typecheck": "yarn build && yarn workspaces foreach -A --exclude @harrymitchinson/oikade-workspace run typecheck",
    "lint": "oxlint sdk plugins",
    "test": "yarn build && vitest run",
    "format": "oxfmt --write sdk plugins vitest.config.ts",
    "format:check": "oxfmt --check sdk plugins vitest.config.ts",
    "check": "yarn format:check && yarn lint",
    "fix": "oxlint --fix sdk plugins && yarn format"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
