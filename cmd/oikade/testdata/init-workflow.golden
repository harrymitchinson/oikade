name: Home

on:
  pull_request:
  push:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - run: go install github.com/harrymitchinson/oikade/cmd/oikade@VERSION
      - run: oikade check
      - run: oikade test
      - name: Deploy is off
        if: github.event_name == 'push' && vars.OIKADE_ADDRESS == ''
        run: |
          echo "::notice title=Deploy is off::Set the variables OIKADE_ADDRESS and OIKADE_PIN and the secret OIKADE_TOKEN to deploy what reaches main, from a self-hosted runner: https://github.com/harrymitchinson/oikade/blob/main/docs/running-a-home.md#deploying-from-ci"

  deploy:
    needs: test
    if: github.event_name == 'push' && vars.OIKADE_ADDRESS != ''
    runs-on: self-hosted
    # One deploy at a time, and a push replaces a deploy still waiting, so the last push wins.
    concurrency: deploy
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      # A self-hosted runner keeps its home between jobs, so this oikade and its login stay out of it.
      - name: Keep to the job's own directory
        run: |
          echo "GOBIN=$RUNNER_TEMP/bin" >> "$GITHUB_ENV"
          echo "XDG_CONFIG_HOME=$RUNNER_TEMP/config" >> "$GITHUB_ENV"
          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
      - run: go install github.com/harrymitchinson/oikade/cmd/oikade@VERSION
      - name: Deploy
        env:
          OIKADE_TOKEN: ${{ secrets.OIKADE_TOKEN }}
          OIKADE_ADDRESS: ${{ vars.OIKADE_ADDRESS }}
          OIKADE_PIN: ${{ vars.OIKADE_PIN }}
        run: |
          oikade login "$OIKADE_ADDRESS" --pin "$OIKADE_PIN"
          oikade deploy
