{
  "name": "@harrymitchinson/oikade-plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Write Oikade plugins that speak the oikade/v1 MQTT contract",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  }
}
