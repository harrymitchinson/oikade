    {
      "id": 30,
      "type": "timeseries",
      "title": "Controller interactions",
      "description": "Attribute writes and commands from controllers, by cluster and the status they were answered with. Commissioning shows as operational_credentials and general_commissioning invokes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
