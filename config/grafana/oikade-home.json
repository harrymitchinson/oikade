    {
      "id": 24,
      "type": "state-timeline",
      "title": "Budgets wanted and running",
      "description": "Whether each budget's plan wants its device on, and whether its device has been on and available in the last 5 minutes, as its run is credited. Running lags the device by up to 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 67,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (rule) (oikade_rule_budget_desired)",
          "legendFormat": "{{rule}} wanted"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "max by (rule) (rate(oikade_rule_budget_run_minutes_total[5m]) > bool 0)",
          "legendFormat": "{{rule}} running"
        }
