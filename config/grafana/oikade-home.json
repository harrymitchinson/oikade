    {
      "id": 23,
      "type": "timeseries",
      "title": "Budget minutes",
      "description": "Each budget hold's minutes for the current planning day, how many the plan places, and how long its device has been on and available so far.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 67,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (rule) (oikade_rule_budget_target_minutes)",
          "legendFormat": "{{rule}} target"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "max by (rule) (oikade_rule_budget_scheduled_minutes)",
          "legendFormat": "{{rule}} scheduled"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "max by (rule) (oikade_rule_budget_today_run_minutes)",
