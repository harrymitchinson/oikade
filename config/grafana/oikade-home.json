      "id": 31,
      "type": "timeseries",
      "title": "Write latency",
      "description": "How long a controller's change takes to get through arbitration to its device's driver.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 80,
        "w": 8,
        "h": 8
