#!/usr/bin/env bash
# owner-approval: whether the user's Approve covers a PR's code as it is now.
# hack/plan merge uses it to merge a needs-review PR, and review-gate.yml to
# pass "Approved by the owner" (docs/design/0108-agent-identity.md).
#
# The user's latest decisive review (an Approve, Request changes or dismissal;
# comments don't count) must approve the head commit, or a commit whose own
# diff is the same as the head's. A restack moves a step onto a new base
# without changing it, so it keeps the Approve. New commits don't.
#
# A step's own diff is from where it leaves its base. For the approved commit
# that's BASE, or, if the user approved it while it was stacked, the step
# below it: the PR before this one in its feature's ## Steps.
#
# The diffs must match byte for byte, whitespace included.
#
# Usage: OWNER=<login> hack/owner-approval PR HEAD_SHA BASE_REF
# Prints why, and exits 0 if the Approve covers HEAD_SHA, 1 if it doesn't, and
# 2 if it couldn't tell.
set -euo pipefail

pr="${1:?usage: OWNER=<login> hack/owner-approval PR HEAD_SHA BASE_REF}"
head="${2:?usage: OWNER=<login> hack/owner-approval PR HEAD_SHA BASE_REF}"
base="${3:?usage: OWNER=<login> hack/owner-approval PR HEAD_SHA BASE_REF}"
owner="${OWNER:?OWNER must name the user whose Approve counts}"
remote="${PLAN_REMOTE:-origin}"

unsure() { echo "$*"; exit 2; }

reviews=$(gh api --paginate "repos/{owner}/{repo}/pulls/$pr/reviews") || unsure "couldn't read PR #$pr's reviews"
review=$(jq -cs --arg owner "$owner" '[.[][] | select(.user.login == $owner and (.state == "APPROVED" or .state == "CHANGES_REQUESTED" or .state == "DISMISSED"))] | last // {state: "none"}' <<<"$reviews")
state=$(jq -r .state <<<"$review")
if [[ "$state" != APPROVED ]]; then
	echo "@$owner hasn't approved PR #$pr (latest review: $state)"
	exit 1
fi

approved=$(jq -r .commit_id <<<"$review")
if [[ "$approved" == "$head" ]]; then
	echo "@$owner approved PR #$pr at its head, $head"
	exit 0
fi

# A restack can leave the approved commit on no branch, so fetch it by id.
for c in "$approved" "$head"; do
	git cat-file -e "$c^{commit}" 2>/dev/null || git fetch -q "$remote" "$c" ||
		unsure "couldn't fetch $c to compare what @$owner approved with PR #$pr's head"
done
git fetch -q "$remote" "+refs/heads/$base:refs/remotes/$remote/$base" || unsure "couldn't fetch $base"
bases=("$remote/$base")

# The step below: "Part of #N" or "Closes #N" names the feature, and the
# nearest ## Steps line above this PR's that records a PR names it. Trying a
# base that wasn't really the one only ever compares one more diff.
# No reader here stops early, so pipefail can't trip on a SIGPIPE.
feature=$(gh pr view "$pr" --json body -q .body | sed -nE '/^(Part of|Closes) #[0-9]+/{s/^(Part of|Closes) #([0-9]+).*/\2/p;q;}') ||
	unsure "couldn't read PR #$pr"
if [[ -n "$feature" ]]; then
	below=$(gh issue view "$feature" --json body -q .body |
		awk -v me="(PR #$pr)" '/^## /{in_steps = ($0 ~ /^## Steps[[:space:]]*$/); next}
			done || !in_steps || !/^- \[[ xX]\] / {next}
			index($0, me) {print prev; done = 1; next}
			match($0, /\(PR #[0-9]+\)[[:space:]]*$/) {prev = substr($0, RSTART + 5); sub(/\).*/, "", prev)}') ||
		unsure "couldn't read #$feature's steps"
	if [[ -n "$below" ]]; then
		git fetch -q "$remote" "refs/pull/$below/head" || unsure "couldn't fetch PR #$below, the step below"
		bases+=("$(git rev-parse FETCH_HEAD)")
	fi
fi

# --verbatim: whitespace is meaning in YAML and Makefiles, so re-indenting
# after the Approve is a change.
patch() {
	local mb
	mb=$(git merge-base "$1" "$2") || return 1
	git diff "$mb" "$2" | git patch-id --verbatim | cut -d' ' -f1
}
now=$(patch "$remote/$base" "$head") || unsure "couldn't diff PR #$pr's head against $base"
for b in "${bases[@]}"; do
	then_=$(patch "$b" "$approved") || continue
	if [[ "$then_" == "$now" ]]; then
		echo "@$owner approved PR #$pr at $approved, and its head $head changes the same lines (a restack)"
		exit 0
	fi
done
echo "@$owner approved PR #$pr at $approved, but its head $head changes more since"
exit 1
