#!/usr/bin/env bash
# agent-token: print a one-hour installation token for the oikade-agent GitHub
# App, so agents act on GitHub as oikade-agent[bot] rather than as the user.
# hack/plan uses it for its issue and PR writes when it runs inside Claude
# Code. Why, and what still acts as the user, is in
# docs/design/0108-agent-identity.md.
#
# The App's ID and private key live in the macOS Keychain, under the service
# "oikade-agent". The key is stored base64-encoded, because the Keychain prints
# a value with newlines in hex:
#
#   security add-generic-password -U -s oikade-agent -a app-id -w <App ID>
#   security add-generic-password -U -s oikade-agent -a private-key -w "$(base64 -i key.pem)"
#
# Usage: hack/agent-token
set -euo pipefail

SERVICE="${AGENT_KEYCHAIN_SERVICE:-oikade-agent}"
API="${GITHUB_API_URL:-https://api.github.com}"

die() { echo "agent-token: $*" >&2; exit 1; }

missing() {
	die "no $1 for the oikade-agent GitHub App in the Keychain (service \"$SERVICE\"), so agents can't act as oikade-agent[bot].
Set it up as the header of hack/agent-token says. Agents never fall back to your login"
}

keychain() { security find-generic-password -s "$SERVICE" -a "$1" -w 2>/dev/null; }

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

command -v security >/dev/null || missing "Keychain (the security command)"
app_id=$(keychain app-id) || missing "app-id"
[[ -n "$app_id" ]] || missing "app-id"
key=$(mktemp)
trap 'rm -f "$key"' EXIT
keychain private-key | openssl base64 -d -A >"$key" 2>/dev/null || missing "private-key"
[[ -s "$key" ]] || missing "private-key"

# A JWT for the App itself, valid for nine minutes. iat is a minute in the past
# to allow for clock drift, as GitHub recommends.
now=$(date +%s)
unsigned="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url).$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$app_id" | b64url)"
sig=$(printf '%s' "$unsigned" | openssl dgst -sha256 -sign "$key" -binary | b64url) || die "couldn't sign a JWT with the Keychain's private-key"
jwt="$unsigned.$sig"

api() {
	local out
	out=$(curl -sS --fail-with-body -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
		-H "X-GitHub-Api-Version: 2022-11-28" "$@") || die "GitHub refused ${*: -1}: $out"
	printf '%s' "$out"
}

repo="${AGENT_REPO:-$(git remote get-url "${PLAN_REMOTE:-origin}" | sed -E 's#^(git@[^:]+:|https://[^/]+/)##; s#\.git$##')}"
installation=$(api "$API/repos/$repo/installation" | jq -r .id)
[[ "$installation" =~ ^[0-9]+$ ]] || die "the oikade-agent App isn't installed on $repo"
api -X POST "$API/app/installations/$installation/access_tokens" | jq -er .token ||
	die "GitHub returned no installation token"
