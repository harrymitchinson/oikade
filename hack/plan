#!/usr/bin/env bash
# plan: Oikade's planning commands, so skills and agents never hand-write
# GraphQL. How planning works is in docs/planning.md.
#
# The plan lives in Linear (team OIK). A feature is one top-level issue, and
# its PR-sized steps are the checklist lines under its "## Steps" heading, in
# order, or its sub-issues where it has them. A feature with neither is a
# single step. A feature is claimed by creating the remote branch claim/OIK-N:
# the push only succeeds if that branch doesn't exist yet, so two agents can't
# both claim it. Line k of OIK-N is built on work/OIKN-stepk, which names no
# issue, so Linear's GitHub integration doesn't move the feature when its PR
# opens or merges: sync ticks the line instead. A sub-issue's step is built on
# work/OIK-S, named for it, which is how Linear links the PR to it. While a
# step waits for review, the next one stacks on it.
#
# Linear calls go out as the Oikade Agent app (hack/linear-token), and GitHub
# writes as oikade-agent[bot] inside Claude Code (hack/agent-token), so an
# agent's work never passes for the user's (docs/planning.md).
#
# Usage: hack/plan <command> [args]   (hack/plan help lists the commands)
# shellcheck disable=SC2016 # $t, $i and the like are GraphQL variables
set -euo pipefail

TEAM="${PLAN_TEAM:-OIK}"
LINEAR_API="${LINEAR_API_URL:-https://api.linear.app/graphql}"
REMOTE="${PLAN_REMOTE:-origin}"
STALE_HOURS="${PLAN_STALE_HOURS:-24}"
# How many of a feature's steps may wait for review at once. Each stacks on the
# one before, so a change asked for low in the stack means rebasing the rest.
MAX_STACK="${PLAN_MAX_STACK:-3}"
# The free plan's limit on issues that aren't archived, and where sync and
# ready start warning about it.
ISSUE_LIMIT="${PLAN_ISSUE_LIMIT:-250}"
ISSUE_WARN="${PLAN_ISSUE_WARN:-225}"
# How many times, and how often, merge retries while GitHub refuses it because
# a required check is still running: 60 times 5 seconds is 5 minutes.
MERGE_TRIES="${PLAN_MERGE_TRIES:-60}"
MERGE_SLEEP="${PLAN_MERGE_SLEEP:-5}"
# The status a design waits in. Only the user moves an issue out of it, and
# that move is the approval.
DESIGN_REVIEW="Design Review"

die() { echo "plan: $*" >&2; exit 1; }

# The dispatch at the bottom looks this repo up once, into HOME_REPO and REPO.
# Claims, Linear and stacks live here. A step whose sub-issue has a line
# "Repo: OWNER/NAME" is built in that repo instead, a plugin's own: on_repo
# points REPO, GH_REPO (every gh call) and STEP_REMOTE (its git remote) at it.
HOME_REPO="" REPO="" STEP_REMOTE="$REMOTE"
repo() { if [[ -n "$REPO" ]]; then echo "$REPO"; else gh repo view --json nameWithOwner -q .nameWithOwner; fi; }

# remote_for REPO: the git remote for REPO, added to this checkout if it's
# missing. This repo's own is REMOTE. Another repo's branches share this .git,
# so its steps get worktrees like any other.
remote_for() {
	local r="$1" name url cur
	if [[ -z "$r" || "$r" == "$HOME_REPO" ]]; then echo "$REMOTE"; return; fi
	name="plan-${r//\//-}" url=$(github_url "$r")
	if cur=$(git remote get-url "$name" 2>/dev/null); then
		[[ "$cur" == "$url" ]] || git remote set-url "$name" "$url" ||
			{ echo "plan: couldn't point the git remote $name at $url" >&2; return 1; }
	else
		git remote add "$name" "$url" || { echo "plan: couldn't add the git remote $name for $r" >&2; return 1; }
	fi
	echo "$name"
}

# github_url REPO: where REPO's git remote points. That's PLAN_GITHUB/REPO.git
# if PLAN_GITHUB is set, as tests set it to local bare repos. Otherwise it's
# GitHub, reached the way REMOTE is, so pushes use the same credentials: an SSH
# key can push workflow files, but the OAuth token git uses over HTTPS may lack
# the workflow scope.
github_url() {
	if [[ -n "${PLAN_GITHUB:-}" ]]; then echo "$PLAN_GITHUB/$1.git"; return; fi
	case "$(git remote get-url "$REMOTE" 2>/dev/null)" in
	git@github.com:* | ssh://git@github.com/*) echo "git@github.com:$1.git" ;;
	*) echo "https://github.com/$1.git" ;;
	esac
}

# on_repo REPO: act on REPO (empty: this repo) from now on.
on_repo() {
	REPO="${1:-$HOME_REPO}"
	export GH_REPO="$REPO"
	STEP_REMOTE=$(remote_for "$1") || exit 1
}

# pr_ref PR: a PR given as N, #N or OWNER/NAME#N. It points on_repo at the
# repo and sets PR_NUM, or stops if PR isn't one.
pr_ref() {
	local p="$1" r=""
	if [[ "$p" == */*#* ]]; then r="${p%%#*}" p="${p##*#}"; fi
	p="${p#\#}"
	[[ "$p" =~ ^[0-9]+$ ]] || die "\"$1\" isn't a PR: give its number, or OWNER/NAME#N for one in another repo"
	[[ "$r" != "$HOME_REPO" ]] || r=""
	PR_NUM="$p"
	on_repo "$r"
}

# The user on GitHub: the repo's owner, as the workflows take it (github.repository_owner).
gh_owner() { local r; r=$(repo); echo "${r%%/*}"; }

need_file() { [[ -f "$1" ]] || die "no such file: $1"; }

# id ARG: an issue identifier, upper-cased, such as OIK-12. Anything else stops.
id() {
	local i
	i=$(tr '[:lower:]' '[:upper:]' <<<"$1")
	[[ "$i" =~ ^[A-Z]+-[0-9]+$ ]] || die "\"$1\" isn't a Linear issue ID such as $TEAM-12"
	echo "$i"
}

# --- Linear -------------------------------------------------------------------

LINEAR_TOKEN=""

# linear_auth: get the Oikade Agent's token once. A missing credential stops
# the command before it reads or writes anything, rather than acting as the user.
linear_auth() {
	[[ -n "$LINEAR_TOKEN" ]] && return 0
	LINEAR_TOKEN=$("$(dirname "$0")/linear-token") ||
		die "can't act as the Oikade Agent in Linear, so nothing was read or written. Fix it as the error above says"
}

# lin QUERY [VARS_JSON]: run a GraphQL call and print its data. Any error stops.
# The token reaches curl through a file descriptor, not its arguments.
lin() {
	local out
	linear_auth
	out=$(jq -cn --arg q "$1" --argjson v "${2:-null}" '{query: $q, variables: ($v // {})}' |
		curl -sS --fail-with-body "$LINEAR_API" -H 'Content-Type: application/json' \
			-H @<(printf 'Authorization: Bearer %s\n' "$LINEAR_TOKEN") --data-binary @-) ||
		die "Linear refused the request: $out"
	jq -e '.errors == null' >/dev/null <<<"$out" || die "Linear: $(jq -r '[.errors[].message] | join("; ")' <<<"$out")"
	jq -c .data <<<"$out"
}

# Read once per run.
STATES=""
states() {
	[[ -n "$STATES" ]] || STATES=$(lin 'query($t: String!) { team(id: $t) { id states { nodes { id name type } } } }' \
		"$(jq -cn --arg t "$TEAM" '{t: $t}')")
	echo "$STATES"
}
team_id() { states | jq -r .team.id; }

# state_id NAME: matched without case, so "todo" finds Todo.
state_id() {
	local s
	s=$(states | jq -r --arg n "$1" '.team.states.nodes[] | select((.name | ascii_downcase) == ($n | ascii_downcase)) | .id')
	[[ -n "$s" ]] || die "$TEAM has no status \"$1\""
	echo "$s"
}

# The user: the workspace's one active admin who isn't an app.
OWNER=""
owner() {
	local o
	if [[ -z "$OWNER" ]]; then
		o=$(lin '{ users(filter: {admin: {eq: true}, active: {eq: true}}) { nodes { id name app } } }' |
			jq -c '[.users.nodes[] | select(.app | not)]')
		[[ "$(jq length <<<"$o")" == 1 ]] || die "can't tell who the user is: Linear has $(jq length <<<"$o") active human admins"
		OWNER=$(jq -c '.[0]' <<<"$o")
	fi
	echo "$OWNER"
}
owner_id() { owner | jq -r .id; }

ISSUE_FIELDS='id identifier title url description priority
	state { name type } project { name } parent { identifier } labels { nodes { name } }
	children(first: 100) { nodes { identifier title description subIssueSortOrder number state { name type } } }
	inverseRelations(first: 100) { nodes { type issue { identifier state { type } } } }'

# issue ID: the issue as JSON, with its steps and blockers.
issue() {
	lin "query(\$i: String!) { issue(id: \$i) { $ISSUE_FIELDS } }" "$(jq -cn --arg i "$1" '{i: $i}')" | jq -c .issue
}

# history ID: the issue's status changes, oldest first: "WHEN<TAB>FROM<TAB>TO<TAB>ACTOR_ID<TAB>ACTOR".
history() {
	local page after="" all="[]"
	while :; do
		page=$(lin 'query($i: String!, $a: String) { issue(id: $i) { history(first: 250, after: $a) {
			nodes { createdAt fromState { name } toState { name } actor { id name } } pageInfo { hasNextPage endCursor } } } }' \
			"$(jq -cn --arg i "$1" --arg a "$after" '{i: $i, a: (if $a == "" then null else $a end)}')") || exit 1
		all=$(jq -c --argjson p "$page" '. + $p.issue.history.nodes' <<<"$all")
		[[ "$(jq -r .issue.history.pageInfo.hasNextPage <<<"$page")" == true ]] || break
		after=$(jq -r .issue.history.pageInfo.endCursor <<<"$page")
	done
	jq -r 'map(select(.toState != null)) | sort_by(.createdAt)[]
		| [.createdAt, (.fromState.name // ""), .toState.name, (.actor.id // ""), (.actor.name // "Linear")] | @tsv' <<<"$all"
}

update_issue() {
	lin 'mutation($i: String!, $in: IssueUpdateInput!) { issueUpdate(id: $i, input: $in) { success } }' \
		"$(jq -cn --arg i "$1" --argjson in "$2" '{i: $i, in: $in}')" >/dev/null
}

set_state() { update_issue "$1" "$(jq -cn --arg s "$(state_id "$2")" '{stateId: $s}')"; }

comment() {
	lin 'mutation($in: CommentCreateInput!) { commentCreate(input: $in) { success } }' \
		"$(jq -cn --arg i "$1" --arg b "$2" '{in: {issueId: $i, body: $b}}')" >/dev/null
}

label_id() {
	local l
	l=$(lin 'query($n: String!) { issueLabels(filter: {name: {eqIgnoreCase: $n}}) { nodes { id } } }' \
		"$(jq -cn --arg n "$1" '{n: $n}')" | jq -r '.issueLabels.nodes[0].id // empty')
	[[ -n "$l" ]] || die "Linear has no label \"$1\""
	echo "$l"
}

project_id() {
	local p
	p=$(lin 'query($n: String!) { projects(filter: {name: {eqIgnoreCase: $n}}) { nodes { id } } }' \
		"$(jq -cn --arg n "$1" '{n: $n}')" | jq -r '.projects.nodes[0].id // empty')
	[[ -n "$p" ]] || die "Linear has no project \"$1\""
	echo "$p"
}

has_label() { jq -e --arg l "$1" '[.labels.nodes[].name | ascii_downcase] | index($l) != null' >/dev/null <<<"$2"; }

open_blockers() {
	jq -r '[.inverseRelations.nodes[] | select(.type == "blocks" and (.issue.state.type | IN("completed", "canceled") | not)) | .issue.identifier] | join(" ")' <<<"$1"
}

# --- GitHub, as the agent ------------------------------------------------------

# Inside Claude Code (CLAUDECODE=1), PR writes go through the oikade-agent
# GitHub App, so they show as oikade-agent[bot]. Git pushes stay as the user.
# The writes use the REST API, which takes an installation token where some gh
# subcommands look up the viewer first.
AGENT_TOKEN=""

agent_token() {
	[[ "${CLAUDECODE:-}" == 1 ]] || return 0
	AGENT_TOKEN=$("$(dirname "$0")/agent-token") ||
		die "this agent session can't act as oikade-agent[bot], so nothing was written. Fix the App's key as the error above says"
}

# as_agent ARGS: gh ARGS as oikade-agent[bot] inside Claude Code, as the user outside it.
as_agent() {
	if [[ "${CLAUDECODE:-}" == 1 ]]; then
		[[ -n "$AGENT_TOKEN" ]] || die "internal: a write ran before agent_token"
		GH_TOKEN="$AGENT_TOKEN" gh "$@"
	else
		gh "$@"
	fi
}

gh_comment() { as_agent api "repos/$(repo)/issues/$1/comments" -f body="$2" >/dev/null; }

# add_pr_label PR LABEL...: one request for all of them.
add_pr_label() {
	local n="$1" l args=()
	shift
	for l in "$@"; do args+=(-f "labels[]=$l"); done
	as_agent api "repos/$(repo)/issues/$n/labels" "${args[@]}" >/dev/null
}

# remove_pr_label PR LABEL: a label that's already gone counts as removed.
remove_pr_label() {
	local err
	err=$(as_agent api -X DELETE "repos/$(repo)/issues/$1/labels/$(jq -rn --arg l "$2" '$l | @uri')" 2>&1 >/dev/null) ||
		[[ "$err" == *"HTTP 404"* ]] || { echo "plan: couldn't remove $2 from #$1: $err" >&2; return 1; }
}

# Labels that record the user's decisions. Agents never remove needs-review
# (the user's review gate) or agent-merged (the user's record of what to look
# at), on a PR or a feature.
label_refusal() {
	local l
	l=$(tr '[:upper:]' '[:lower:]' <<<"$2")
	case "$1$l" in
	-needs-review) echo "only the user removes needs-review: it holds work for their review" ;;
	-agent-merged) echo "only the user removes agent-merged, once they've reviewed the PR" ;;
	esac
}

usage() {
	cat <<'EOF'
Usage: hack/plan <command> [args]        IDs are Linear issues, such as OIK-12

Work
  ready                 Features agents may build that nobody has claimed and nothing blocks, earliest release first
  show ID               A feature: its description, steps and their PRs, why it may be built, blockers and claim
  claim ID [DIR]        Claim feature ID and create a worktree on its next step's branch
                        (work/OIKN-stepk for line k, work/OIK-S for a sub-issue)
                        (default DIR .claude/worktrees/work-ID)
  step ID               In ID's worktree, once the current step has a PR: start the next step on its own branch
  pr ID TITLE BODY_FILE Push the current step's branch and open its PR on the right base
  merge ID PR           Merge a step's PR if docs/planning.md allows it, then restack. One held for the
                        user merges once their Approve covers its head. If nobody holds ID's claim, it
                        holds it while it runs. A PR in another repo is OWNER/NAME#N
  repo init OWNER/NAME  Give an empty repo, such as a new plugin's, a main with a README to build on
  restack ID            Rebase the steps stacked on a step that merged onto main
  release ID [--force]  Give up a claim: delete branch claim/ID and set the feature back to Todo. Step
                        branches stay. Refuses if claim/ID itself has commits, unless --force
  claims                Every claimed feature, with its open PRs and how long since its last commit
  digest [DAYS]         What agents merged in the last DAYS days (default 7), for the user to skim
  sync [ID]             Set steps and features from their PRs, and unclaimed features back to Todo
  note ID|PR TEXT       Comment on a Linear issue or a GitHub PR

A feature's steps are the lines "- [ ] <step>" under its "## Steps" heading, or its sub-issues.
Line k of OIK-N is built on work/OIKN-stepk, and sync ticks it once its PR merges into main.

A step whose sub-issue has a line "Repo: OWNER/NAME" is built in that repo: its own worktree from
that repo's main, and its PR opened and merged there. It never stacks. Name its PR as OWNER/NAME#N.

Issues (agents use these, never raw writes)
  issue TITLE BODY_FILE [--state S] [--project P] [--parent ID] [--label L]...
                        Create an issue (default state Backlog) and print its ID. A step is a
                        line in its feature's ## Steps checklist. An issue with --parent is a
                        step of its own, for one that needs its own discussion or another repo
  edit ID BODY_FILE     Replace an issue's description. An approved design can't change above ## Steps
  title ID TITLE        Replace an issue's title
  state ID STATE        Move an issue. Never out of Design Review, and never into Todo once it has
                        been in Design Review: those are the user's decision
  label ID|PR +L|-L...  Add (+) or remove (-) labels. Never removes needs-review or agent-merged
  block ID BLOCKER      Record that ID is blocked by BLOCKER

Releases (Linear projects)
  projects              Every project, with its status and description
  project new NAME FILE         Create a project
  project edit NAME FILE        Replace a project's description
  project set ID NAME           Put an issue in a project
  project close NAME            Mark a project completed
  project rename NAME NEW       Rename a project

Ideas (issues in Triage)
  ideas                 List the ideas
  idea TITLE [BODY]     Add an idea
  promote ID [STATE]    Move an idea out of Triage (default Backlog)
EOF
}

# --- Steps --------------------------------------------------------------------

# steps JSON: "IDX<TAB>STEP<TAB>STATE_TYPE<TAB>REPO<TAB>TITLE" for each step, in
# order. A feature's steps are its sub-issues if it has any, or else the
# top-level checklist lines under its first "## Steps" heading, up to the next
# "## " heading (checklist_lines reads the same ones): line k of OIK-N is the step
# OIKN-stepk, completed once it's ticked, and always in this repo. A feature
# with neither is its own single step. REPO is the OWNER/NAME from a "Repo:"
# line in a sub-issue's description, or - for this repo.
steps() {
	jq -r 'def repo: [(.description // "") | gsub("[\\\\*`]"; "")
			| scan("(?m)^[ \t]*Repo:[ \t]*\\[?([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)")[0]] | .[0] // "-";
		def checklist: (.description // "") | split("\n")
			| (map(test("^##[ \t]+Steps[ \t]*$")) | index(true)) as $h
			| if $h == null then [] else .[$h + 1:]
				| (map(test("^##[ \t]")) | index(true)) as $e | (if $e == null then . else .[:$e] end)
				| map(capture("^[-*][ \t]+\\[(?<x>[ xX])\\][ \t]+(?<t>.*)$")) end;
		if (.children.nodes | length) > 0 then .children.nodes | sort_by(.subIssueSortOrder, .number) | to_entries[]
			| [.key + 1, .value.identifier, .value.state.type, (.value | repo), .value.title] | @tsv
		elif (checklist | length) > 0 then (.identifier | sub("-"; "")) as $f | checklist | to_entries[]
			| [.key + 1, "\($f)-step\(.key + 1)", (if .value.x == " " then "unstarted" else "completed" end), "-", .value.t] | @tsv
		else [1, .identifier, .state.type, repo, .title] | @tsv end' <<<"$1"
}

# line_step STEP: k if STEP is line k of its feature's checklist, or nothing
# if it's an issue: a sub-issue, or the feature itself.
line_step() { if [[ "$1" =~ ^[A-Z]+[0-9]+-step([0-9]+)$ ]]; then echo "${BASH_REMATCH[1]}"; fi; }

# sub_issue STEP FEATURE: whether STEP is an issue of its own, whose status
# follows its PR.
sub_issue() { [[ "$1" != "$2" && -z "$(line_step "$1")" ]]; }

# checklist_lines: "TICKED<TAB>TEXT" for each step line in the description on
# stdin, where TICKED is x or -: the lines steps reads. A step is identified by
# its position, so lines are only ever added at the end (cmd_edit).
checklist_lines() {
	awk '/^##[ \t]+Steps[ \t]*$/ && !d {s = 1; next}
		s && /^##[ \t]/ {s = 0; d = 1}
		s && /^[-*][ \t]+\[[ xX]\][ \t]/ {
			t = substr($0, index($0, "[") + 1, 1); r = $0
			sub(/^[-*][ \t]+\[[ xX]\][ \t]+/, "", r)
			print (t == " " ? "-" : "x") "\t" r}'
}

# tick ID K: tick line K of ID's ## Steps checklist. Linear has no
# compare-and-swap, so it reads the description just before writing it back.
tick() {
	local d
	d=$(issue "$1" | jq -r '.description // ""') || exit 1
	d=$(awk -v k="$2" '
		/^##[ \t]+Steps[ \t]*$/ && !d {s = 1; print; next}
		s && /^##[ \t]/ {s = 0; d = 1}
		s && /^[-*][ \t]+\[[ xX]\][ \t]/ {if (++n == k) sub(/\[ \]/, "[x]")}
		{print}' <<<"$d")
	update_issue "$1" "$(jq -cn --arg d "$d" '{description: $d}')"
}

# step_repo JSON STEP: the repo STEP is built in, or nothing for this repo.
step_repo() { steps "$1" | awk -F'\t' -v s="$2" '$2 == s && $4 != "-" {print $4}'; }

# step_pr STEP [REPO]: "PR<TAB>STATE<TAB>BASE<TAB>HEAD_OID" for the latest PR
# from the step's branch, in REPO (- or nothing: this repo), or nothing.
step_pr() {
	local r="${2:--}"
	[[ "$r" != - ]] || r="$HOME_REPO"
	GH_REPO="$r" gh pr list --head "work/$1" --state all --limit 1 --json number,state,baseRefName,headRefOid \
		-q '.[0] | select(. != null) | "\(.number)\t\(.state)\t\(.baseRefName)\t\(.headRefOid)"'
}

# step_prs JSON: "IDX<TAB>PR<TAB>TICKED" for every step in this repo with an
# open or merged PR, in order. TICKED is x for a step that's done, and -
# otherwise. Steps in other repos never stack, so they're left out.
step_prs() {
	local i s type repo title pr st base oid
	while IFS=$'\t' read -r i s type repo title; do
		[[ "$repo" == - ]] || continue
		IFS=$'\t' read -r pr st base oid <<<"$(step_pr "$s")"
		[[ "$st" == OPEN || "$st" == MERGED ]] || continue
		# Not Linear's Done alone: it marks a step done when its PR merges into
		# the step below it, before the change reaches main.
		if [[ "$st $base" == "MERGED main" ]]; then
			printf '%s\t%s\tx\n' "$i" "$pr"
		else
			printf '%s\t%s\t-\n' "$i" "$pr"
		fi
	done < <(steps "$1")
}

# next_step JSON: "IDX<TAB>STEP<TAB>TITLE" for the first step that isn't done
# and has no open or merged PR.
next_step() {
	local i s type repo title st
	while IFS=$'\t' read -r i s type repo title; do
		[[ "$type" == completed || "$type" == canceled ]] && continue
		st=$(step_pr "$s" "$repo" | cut -f2)
		[[ "$st" == OPEN || "$st" == MERGED ]] && continue
		printf '%s\t%s\t%s\n' "$i" "$s" "$title"
		return
	done < <(steps "$1")
}

# stack_prs JSON: step_prs from the last ticked step below the first step in
# review, which is all restack needs.
stack_prs() {
	step_prs "$1" | awk -F'\t' '{line[NR] = $0; t[NR] = $3} END {
		for (f = 1; f <= NR && t[f] == "x"; f++) {}
		for (i = (f > 1 ? f - 1 : 1); i <= NR; i++) print line[i]}'
}

# step_of JSON BRANCH: the step whose branch BRANCH is, or nothing.
step_of() {
	local i s type repo title
	while IFS=$'\t' read -r i s type repo title; do
		if [[ "$2" == "work/$s" ]]; then echo "$s"; return; fi
	done < <(steps "$1")
}

# --- Who may build it ---------------------------------------------------------

# approval ID: "approved<TAB>WHO" if the user moved ID out of Design Review,
# "unapproved<TAB>WHO" if someone else did, "waiting" if it's still there, or
# nothing if it never was. An issue created in Design Review has no move into
# it in its history, so it's in its current status too. A failed read stops
# the command: callers in a command substitution add || exit, since bash
# doesn't carry set -e into one.
approval() {
	local h cur last o
	h=$(history "$1") || die "couldn't read $1's history, so whether the user approved it is unknown"
	cur=$(issue "$1" | jq -r .state.name) || die "couldn't read $1"
	[[ "$cur" == "$DESIGN_REVIEW" ]] && { echo waiting; return; }
	last=$(awk -F'\t' -v d="$DESIGN_REVIEW" '$2 == d {l = $0} END {print l}' <<<"$h")
	if [[ -z "$last" ]]; then
		return 0
	elif [[ "$(cut -f3 <<<"$last")" =~ ^(Backlog|Triage|Canceled|Duplicate)$ ]]; then
		printf 'returned\t%s\n' "$(cut -f5 <<<"$last")"
	fi
	o=$(owner_id) || exit 1
	[[ -n "$o" ]] || die "couldn't tell who the user is"
	if [[ "$(cut -f4 <<<"$last")" == "$o" ]]; then
		printf 'approved\t%s\n' "$(cut -f5 <<<"$last")"
	else
		printf 'unapproved\t%s\n' "$(cut -f5 <<<"$last")"
	fi
}

# gate JSON: why agents may build the feature, or nothing if they may not. The
# user approved its design, or it never needed one, or it builds part of a
# design the user approved in another feature, named by a "Design: OIK-M" line.
gate() {
	local i a="" design
	i=$(jq -r .identifier <<<"$1")
	case "$(jq -r .state.name <<<"$1")" in Todo | "In Progress") ;; *) return 0 ;; esac
	a=$(approval "$i") || exit 1
	case "$a" in
	approved*) echo "approved"; return ;;
	?*) return 0 ;;
	esac
	design=$(jq -r .description <<<"$1" | sed -nE 's/^Design:[^A-Za-z]*([A-Za-z]+-[0-9]+).*/\1/p' | head -1)
	if [[ -n "$design" ]]; then
		design=$(id "$design")
		[[ "$design" != "$i" ]] || return 0
		a=$(approval "$design") || exit 1
		[[ "$a" != approved* ]] || echo "builds the design approved in $design"
		return 0
	fi
	echo "needs no design"
}

# --- Claims and stacks ----------------------------------------------------------

claimed_ids() {
	git ls-remote --heads "$REMOTE" 'refs/heads/claim/*' | sed -E 's#.*refs/heads/claim/##' || true
}

is_claimed() { git ls-remote --exit-code --heads "$REMOTE" "refs/heads/claim/$1" >/dev/null; }

# open_stack JSON: "IDX<TAB>PR<TAB>BRANCH" for each step whose PR is open, in
# order. The last one is the base for the next step.
open_stack() {
	local i s type repo title pr st base oid
	while IFS=$'\t' read -r i s type repo title; do
		[[ "$repo" == - ]] || continue
		IFS=$'\t' read -r pr st base oid <<<"$(step_pr "$s")"
		[[ "$st" == OPEN ]] && printf '%s\t%s\twork/%s\n' "$i" "$pr" "$s"
	done < <(steps "$1")
	return 0
}

stack_base() { local b; b=$(open_stack "$1" | tail -1 | cut -f3); echo "${b:-main}"; }

stack_size() { open_stack "$1" | grep -c . || true; }

fetch_branch() { git fetch -q "$REMOTE" "+refs/heads/$1:refs/remotes/$REMOTE/$1"; }

# start_step ID [DIR]: put ID's next step on its branch work/STEP, based on
# the last step still in review, or on main. With DIR it's a new worktree
# there, otherwise the current worktree switches to it. A branch pushed by an
# earlier session that has no PR yet is resumed. It sets STEP_BASE and STEP
# rather than printing them, so it never runs in a command substitution, where
# bash ignores set -e.
start_step() {
	local n="$1" dir="${2:-}" json next idx base branch oid start closed prev r
	restack "$n"
	json=$(issue "$n")
	next=$(next_step "$json")
	[[ -n "$next" ]] || die "$n has no step left to build: each step is done or has a PR"
	idx=$(cut -f1 <<<"$next") STEP=$(cut -f2 <<<"$next")
	r=$(step_repo "$json" "$STEP")
	if [[ -n "$r" ]]; then
		start_step_in "$r" "$dir"
		return
	fi
	(( $(stack_size "$json") < MAX_STACK )) || die "$MAX_STACK steps of $n are waiting for review. Stop until the user merges one"
	# A step here after one in another repo can't switch that repo's worktree.
	if [[ -z "$dir" && -n "${FROM_REPO:-}" ]]; then dir=$(worktree_dir "$STEP"); fi
	base=$(stack_base "$json")
	branch="work/$STEP"
	git show-ref --verify --quiet "refs/heads/$branch" &&
		die "a local branch $branch exists. If it's left from an earlier session and pushed, delete it: git branch -D $branch"
	fetch_branch "$base"
	if git ls-remote --exit-code --heads "$REMOTE" "refs/heads/$branch" >/dev/null; then
		closed=$(gh pr list --head "$branch" --state closed --json number -q '.[0].number // empty')
		[[ -z "$closed" ]] || die "$branch belongs to PR #$closed, which was closed without merging. Ask the user whether to delete the branch or reopen the PR"
		fetch_branch "$branch"
		start="$REMOTE/$branch"
		oid=$(git merge-base "$REMOTE/$branch" "$REMOTE/$base")
		# If the step below was squash-merged since, the branch still holds its
		# original commits. Start from that step's last commit, so pr replays
		# only this step's own.
		prev=$(step_prs "$json" | awk -F'\t' -v s="$idx" '$1 < s && $3 == "x" {pr = $2} END {print pr}')
		if [[ -n "$prev" && "$base" == main ]]; then
			git fetch -q "$REMOTE" "refs/pull/$prev/head"
			prev=$(git rev-parse FETCH_HEAD)
			if git merge-base --is-ancestor "$prev" "$REMOTE/$branch"; then oid="$prev"; fi
		fi
		echo "plan: resuming $branch, which an earlier session pushed" >&2
	else
		oid=$(git rev-parse "$REMOTE/$base")
		start="$oid"
	fi
	if [[ -n "$dir" ]]; then
		git worktree add -q -b "$branch" "$dir" "$start"
	else
		git switch -q -c "$branch" "$start"
	fi
	# Where the step started, so pr can move it if its base merges meanwhile.
	git config "branch.$branch.plan-base-oid" "$oid"
	STEP_BASE="$base" STEP_DIR="$dir"
}

# worktree_dir STEP: where a step that needs its own worktree gets it.
worktree_dir() { echo "$(git rev-parse --path-format=absolute --git-common-dir | sed 's#/.git$##')/.claude/worktrees/work-$1"; }

# start_step_in REPO [DIR]: put STEP on work/STEP in REPO, a plugin's own repo,
# based on its main. It always gets its own worktree, since its files have
# nothing in common with this repo's. Steps in another repo never stack.
start_step_in() {
	local r="$1" dir="${2:-}" rem branch="work/$STEP" closed start oid
	rem=$(remote_for "$r")
	git fetch -q "$rem" || die "couldn't fetch $r. Does it exist, and can your git credentials read it?"
	git rev-parse -q --verify "$rem/main" >/dev/null || die "$r has no main yet. Start it: hack/plan repo init $r"
	dir="${dir:-$(worktree_dir "$STEP")}"
	[[ ! -e "$dir" ]] || die "$dir already exists. If it's left from an earlier session: git worktree remove $dir"
	git show-ref --verify --quiet "refs/heads/$branch" &&
		die "a local branch $branch exists. If it's left from an earlier session and pushed, delete it: git branch -D $branch"
	if git rev-parse -q --verify "$rem/$branch" >/dev/null; then
		closed=$(GH_REPO="$r" gh pr list --head "$branch" --state closed --json number -q '.[0].number // empty')
		[[ -z "$closed" ]] || die "$branch in $r belongs to PR #$closed, which was closed without merging. Ask the user whether to delete the branch or reopen the PR"
		start="$rem/$branch" oid=$(git merge-base "$rem/$branch" "$rem/main")
		echo "plan: resuming $branch in $r, which an earlier session pushed" >&2
	else
		start="$rem/main" oid=$(git rev-parse "$rem/main")
	fi
	git worktree add -q --no-track -b "$branch" "$dir" "$start"
	git config "branch.$branch.plan-base-oid" "$oid"
	STEP_BASE="main of $r" STEP_DIR="$dir"
}

# restack ID: after a step in review merges, rebase the steps stacked on it onto
# main, and each later step onto the rewritten one before it. Squash merging
# gives main a new commit, so otherwise their PRs still show the merged step.
restack() {
	local n="$1" json s pr info state head head_oid base old="" new="" tmp first
	json=$(issue "$n")
	git fetch -q "$REMOTE" main
	while IFS=$'\t' read -r s pr _; do
		[[ -n "$pr" ]] || continue
		info=$(gh pr view "$pr" --json state,headRefName,headRefOid,baseRefName -q '"\(.state) \(.headRefName) \(.headRefOid) \(.baseRefName)"')
		read -r state head head_oid base <<<"$info"
		case "$state" in
		MERGED)
			# A step merged into the step below it, rather than into main, is
			# in that step's branch now. Nothing above it needs to move.
			if [[ "$base" != main ]]; then old="" new=""; continue; fi
			git fetch -q "$REMOTE" "refs/pull/$pr/head"
			old="$head_oid" new=$(git rev-parse "$REMOTE/main")
			;;
		OPEN)
			git fetch -q "$REMOTE" "refs/pull/$pr/head"
			if [[ -z "$old" ]] || ! git merge-base --is-ancestor "$old" "$head_oid"; then
				old="" new=""
				continue
			fi
			tmp=$(mktemp -d)
			git worktree add -q --detach "$tmp" "$head_oid"
			if ! git -C "$tmp" rebase -q --onto "$new" "$old"; then
				git -C "$tmp" rebase --abort || true
				git worktree remove --force "$tmp"
				die "couldn't restack PR #$pr ($head): rebase it by hand with git rebase --onto $new $old"
			fi
			old="$head_oid" new=$(git -C "$tmp" rev-parse HEAD)
			git worktree remove --force "$tmp"
			git push -q --force-with-lease="refs/heads/$head:$head_oid" "$REMOTE" "$new:refs/heads/$head"
			# GitHub retargets a PR whose base branch was deleted on merge, but
			# not always before this runs.
			first=$(open_stack "$json" | head -1 | cut -f1)
			if [[ "$s" == "$first" && "$base" != main ]]; then as_agent api -X PATCH "repos/$(repo)/pulls/$pr" -f base=main >/dev/null; fi
			echo "plan: restacked PR #$pr ($head)" >&2
			;;
		*) old="" new="" ;;
		esac
	done < <(stack_prs "$json")
}

# --- Commands -------------------------------------------------------------------

# count_issues: say on stderr how many issues aren't archived, of the free
# plan's limit, and warn once they near it. Linear counts the whole workspace.
count_issues() {
	local page after="" n=0
	while :; do
		# Only advice, so a failure says so and lets the command go on.
		page=$(lin 'query($a: String) { issues(first: 250, after: $a) { nodes { id } pageInfo { hasNextPage endCursor } } }' \
			"$(jq -cn --arg a "$after" '{a: (if $a == "" then null else $a end)}')") ||
			{ echo "plan: couldn't count Linear's issues" >&2; return 0; }
		n=$((n + $(jq '.issues.nodes | length' <<<"$page")))
		[[ "$(jq -r .issues.pageInfo.hasNextPage <<<"$page")" == true ]] || break
		after=$(jq -r .issues.pageInfo.endCursor <<<"$page")
	done
	if (( n > ISSUE_WARN )); then
		echo "plan: $n of Linear's $ISSUE_LIMIT issues are used. Write steps as checklist lines, not sub-issues, and tag what's safe to delete to-delete for the user" >&2
	else
		echo "plan: $n of Linear's $ISSUE_LIMIT issues are used" >&2
	fi
}

cmd_ready() {
	local claimed features n json
	count_issues
	claimed=" $(claimed_ids | tr '\n' ' ') "
	features=$(lin 'query($t: String!) { issues(first: 250, filter: {team: {key: {eq: $t}}, parent: {null: true},
		state: {name: {in: ["Todo", "In Progress"]}}}) { nodes { identifier number title project { name } } } }' \
		"$(jq -cn --arg t "$TEAM" '{t: $t}')" |
		jq -r '.issues.nodes
			| sort_by([((.project.name // "v9999") | ltrimstr("v") | split(".") | map(tonumber? // 9999)), .number])[]
			| [.identifier, (.project.name // "-"), .title] | @tsv')
	[[ -n "$features" ]] || return 0
	while IFS=$'\t' read -r n _ _; do
		[[ "$claimed" == *" $n "* ]] && continue
		json=$(issue "$n")
		[[ -n "$(next_step "$json")" ]] || continue
		[[ -n "$(gate "$json")" ]] || continue
		[[ -z "$(open_blockers "$json")" ]] || continue
		(( $(stack_size "$json") < MAX_STACK )) || continue
		grep -F "$n"$'\t' <<<"$features"
	done <<<"$features"
}

cmd_show() {
	local n json why a="" blockers i s type repo title pr st base oid
	n=$(id "${1:?usage: plan show ID}")
	json=$(issue "$n")
	jq -r '"\(.identifier) \(.title)\n\(.url)\nStatus:     \(.state.name)\nRelease:    \(.project.name // "none")\nLabels:     \([.labels.nodes[].name] | join(", "))\n\n\(.description // "")\n"' <<<"$json"
	echo "Steps:"
	while IFS=$'\t' read -r i s type repo title; do
		IFS=$'\t' read -r pr st base oid <<<"$(step_pr "$s" "$repo")"
		printf '  %s. %s %s [%s]%s%s\n' "$i" "$s" "$title" "$type" "${pr:+ PR #$pr $st${base:+ → $base}}" "$([[ "$repo" == - ]] || echo " (in $repo)")"
	done < <(steps "$json")
	echo
	echo "Next step:  $(next_step "$json" | cut -f2,3 | tr '\t' ' ')"
	why=$(gate "$json")
	[[ -n "$why" ]] || why="no: it must be in Todo, and if it was ever in $DESIGN_REVIEW, the user must have moved it out"
	echo "May build:  $why"
	a=$(approval "$n") || exit 1
	case "$a" in
	approved*) echo "Approved:   by $(cut -f2 <<<"$a")" ;;
	unapproved*) echo "Approved:   moved out of $DESIGN_REVIEW by $(cut -f2 <<<"$a"), not the user, so it doesn't count" ;;
	returned*) echo "Approved:   no: $(cut -f2 <<<"$a") moved it back out of $DESIGN_REVIEW without approving it" ;;
	waiting) echo "Approved:   not yet: it waits in $DESIGN_REVIEW" ;;
	esac
	blockers=$(open_blockers "$json")
	echo "Blocked by: ${blockers:-nothing open}"
	if is_claimed "$n"; then echo "Claimed:    branch claim/$n"; else echo "Claimed:    no"; fi
}

# take_claim ID MESSAGE: push branch claim/ID, or stop if anyone else has it.
# Each claim pushes its own empty commit. If two claims pushed the same commit,
# the second would be a no-op "up to date" push and succeed too. The empty
# expected value means "only if claim/ID doesn't exist", and the server checks
# it atomically, so exactly one of two racing claims wins. Nothing builds on
# the claim commit: steps have their own branches. It sets CLAIM_OID to the
# commit it pushed, so giving the claim back can't delete a later one.
take_claim() {
	local n="$1" claim err
	git fetch -q "$REMOTE" main
	claim=$(git commit-tree "$REMOTE/main^{tree}" -p "$REMOTE/main" \
		-m "$2" -m "$(hostname -s) $$ $(date -u +%FT%TZ) $RANDOM")
	if ! err=$(git push -q --force-with-lease="refs/heads/claim/$n:" "$REMOTE" "$claim:refs/heads/claim/$n" 2>&1); then
		is_claimed "$n" && die "$n was claimed by someone else just now. See: hack/plan claims"
		die "couldn't push claim/$n: $err"
	fi
	CLAIM_OID="$claim"
}

cmd_claim() {
	local n dir="${2:-}" json
	n=$(id "${1:?usage: plan claim ID [DIR]}")
	json=$(issue "$n")
	[[ "$(jq -r '.parent.identifier // empty' <<<"$json")" == "" ]] ||
		die "$n is a step of $(jq -r .parent.identifier <<<"$json"): claim the feature"
	[[ -n "$(gate "$json")" ]] ||
		die "$n may not be built yet: it must be in Todo, and out of $DESIGN_REVIEW by the user's move, if it was ever there. See: hack/plan show $n"
	[[ -z "$(open_blockers "$json")" ]] || die "$n is blocked by $(open_blockers "$json")"
	is_claimed "$n" && die "$n is already claimed (branch claim/$n exists). See: hack/plan claims"
	[[ -n "$(next_step "$json")" ]] || die "$n has no step left to build: each step is done or has a PR"

	dir="${dir:-$(worktree_dir "$n")}"
	[[ ! -e "$dir" ]] || die "$dir already exists. If it's left from an earlier session: git worktree remove $dir"

	take_claim "$n" "chore: claim $n"
	# Starting the step restacks branches, so it runs only once the claim is
	# held. If it fails, give the claim back rather than leave one nobody holds.
	# shellcheck disable=SC2064 # expand $n now
	trap "echo 'plan: gave the claim on $n back' >&2; git push -q '$REMOTE' --delete 'claim/$n' || true" EXIT
	start_step "$n" "$dir"
	trap - EXIT
	set_state "$n" "In Progress"
	if sub_issue "$STEP" "$n"; then set_state "$STEP" "In Progress"; fi
	comment "$n" "Claimed on branch \`claim/$n\` ($(hostname -s), $(date -u +%FT%TZ)). Building $STEP on \`work/$STEP\`, on top of \`$STEP_BASE\`."
	echo "$STEP_DIR"
}

cmd_step() {
	local n branch json s state r rem
	n=$(id "${1:?usage: plan step ID}")
	is_claimed "$n" || die "$n isn't claimed. Claim it first: hack/plan claim $n"
	branch=$(git branch --show-current)
	json=$(issue "$n")
	s=$(step_of "$json" "$branch")
	[[ -n "$s" ]] || die "run this in $n's worktree, on a step branch (this is ${branch:-a detached HEAD})"
	r=$(step_repo "$json" "$s")
	state=$(step_pr "$s" "$r" | cut -f2)
	[[ -n "$state" ]] || die "$branch has no PR yet. Open it first: hack/plan pr $n TITLE BODY_FILE"
	[[ -z "$(git status --porcelain)" ]] || die "the worktree has uncommitted changes"
	# A merged step's branch is gone from GitHub, and the next step builds on main.
	if [[ "$state" != MERGED ]]; then
		rem=$(remote_for "$r")
		git fetch -q "$rem" "+refs/heads/$branch:refs/remotes/$rem/$branch"
		[[ "$(git rev-list --count "$rem/$branch..HEAD")" == 0 ]] ||
			die "$branch has commits that aren't pushed, and the next step builds on the pushed branch. Push first: git push"
	fi
	FROM_REPO="$r" start_step "$n"
	if sub_issue "$STEP" "$n"; then set_state "$STEP" "In Progress"; fi
	if [[ -n "$STEP_DIR" ]]; then
		echo "On work/$STEP in $STEP_DIR, on top of $STEP_BASE"
	else
		echo "On $(git branch --show-current), on top of $STEP_BASE"
	fi
}

cmd_pr() {
	local n title="${2:?usage: plan pr ID TITLE BODY_FILE}" file="${3:?usage: plan pr ID TITLE BODY_FILE}"
	local branch json s base oid url pr body r rem k
	n=$(id "${1:?usage: plan pr ID TITLE BODY_FILE}")
	need_file "$file"
	branch=$(git branch --show-current)
	json=$(issue "$n")
	s=$(step_of "$json" "$branch")
	[[ -n "$s" ]] || die "run this in $n's worktree, on a step branch (this is ${branch:-a detached HEAD})"
	[[ -z "$(git status --porcelain)" ]] || die "the worktree has uncommitted changes"
	r=$(step_repo "$json" "$s")
	pr=$(step_pr "$s" "$r" | awk -F'\t' '$2 == "OPEN" {print $1}')
	[[ -z "$pr" ]] || die "$branch already has PR #$pr"
	if [[ -z "$r" ]]; then
		restack "$n"
		json=$(issue "$n")
		base=$(stack_base "$json")
	else
		# A step in another repo never stacks: it's always on that repo's main.
		base=main
	fi
	on_repo "$r"
	rem="$STEP_REMOTE"
	git fetch -q "$rem" "+refs/heads/$base:refs/remotes/$rem/$base"
	# If the step this one stacked on has merged or been restacked since, move
	# this step's own commits onto where its base is now.
	oid=$(git config "branch.$branch.plan-base-oid" || git merge-base HEAD "$rem/$base")
	if ! git merge-base --is-ancestor "$rem/$base" HEAD; then
		git rebase -q --onto "$rem/$base" "$oid" || { git rebase --abort || true; die "couldn't rebase $branch onto $base: rebase by hand, then rerun"; }
	fi
	git config "branch.$branch.plan-base-oid" "$(git rev-parse "$rem/$base")"
	git push -q --force-with-lease -u "$rem" "$branch"
	# The branch name links the PR to its step in Linear. The trailer names both.
	# A checklist line's PR names its feature with "part of", which links it
	# without moving the feature when it merges.
	k=$(line_step "$s")
	if [[ -n "$k" ]]; then
		body="$(cat "$file")"$'\n\n'"Linear: part of $n, step $k"
	else
		body="$(cat "$file")"$'\n\n'"Linear: $s"
		[[ "$s" == "$n" ]] || body+=", part of $n"
	fi
	url=$(as_agent api "repos/$(repo)/pulls" -f head="$branch" -f base="$base" -f title="$title" -f body="$body" -q .html_url) ||
		die "couldn't open the PR in $(repo). If it's a plugin repo, the user gives the oikade-agent App access to it"
	pr="${url##*/}"
	# A feature the user wants to review holds every one of its PRs for them.
	if has_label needs-review "$json"; then add_pr_label "$pr" needs-review; fi
	[[ -n "$k" ]] || set_state "$s" "In Review"
	echo "$url"
}

cmd_merge() {
	local n pr="${2:?usage: plan merge ID PR}" err json info state head base draft mergeable oid labels checks failing workflow s sr held=() approval r="" rem overlap behind=""
	n=$(id "${1:?usage: plan merge ID PR}")
	# A step in a plugin's own repo names its PR as OWNER/NAME#N. pr_ref
	# checks it now, and merge points at its repo after the restack here.
	pr_ref "$pr"
	pr="$PR_NUM" r="$REPO"
	[[ "$r" != "$HOME_REPO" ]] || r=""
	on_repo ""
	json=$(issue "$n")
	# Merging restacks the feature's branches, so it needs the claim. If nobody
	# holds it, as once the session that built the steps has released it, the
	# merge takes it for as long as it runs, so no session builds on a branch
	# it's moving, and gives it back however it ends. Taking it asks what claim
	# does: a feature the user has stopped can't be claimed to merge either.
	if ! is_claimed "$n"; then
		[[ "$(jq -r '.parent.identifier // empty' <<<"$json")" == "" ]] ||
			die "$n is a step of $(jq -r .parent.identifier <<<"$json"): merge with the feature's ID"
		[[ -n "$(gate "$json")" ]] ||
			die "$n isn't claimed, and may not be built, so its PRs don't merge: it must be in Todo or In Progress, and out of $DESIGN_REVIEW by the user's move, if it was ever there. See: hack/plan show $n"
		take_claim "$n" "chore: claim $n to merge PR #$pr"
		# The lease deletes only the claim this merge pushed.
		# shellcheck disable=SC2064 # expand $n and CLAIM_OID now
		trap "git push -q --force-with-lease='refs/heads/claim/$n:$CLAIM_OID' '$REMOTE' --delete 'claim/$n' ||
			echo 'plan: couldn'\''t give back claim/$n. If it is still the merge'\''s: hack/plan release $n' >&2" EXIT
		echo "plan: nobody held $n's claim, so it's held while PR #$pr merges" >&2
	fi
	if has_label needs-review "$json"; then held+=("$n has the needs-review label"); fi
	restack "$n"
	on_repo "$r"
	rem="$STEP_REMOTE"
	git fetch -q "$rem" main
	# GitHub reports UNKNOWN for a few seconds after a push to the PR or main.
	for _ in 1 2 3 4 5 6; do
		info=$(gh pr view "$pr" --json state,headRefName,baseRefName,isDraft,mergeable,headRefOid,labels \
			-q '"\(.state) \(.headRefName) \(.baseRefName) \(.isDraft) \(.mergeable) \(.headRefOid) ,\([.labels[].name] | join(",")),"')
		read -r state head base draft mergeable oid labels <<<"$info"
		[[ "$mergeable" == UNKNOWN ]] || break
		sleep 5
	done
	[[ "$state" == OPEN ]] || die "PR #$pr is $state"
	s=$(step_of "$json" "$head")
	[[ -n "$s" ]] || die "PR #$pr isn't from one of $n's step branches"
	sr=$(step_repo "$json" "$s")
	[[ "$sr" == "$r" ]] || die "PR #$pr is from $s, which is built in ${sr:-this repo}: name it as ${sr:+$sr#}$pr"
	[[ "$base" == main ]] || die "PR #$pr is stacked on $base: the step below it has to merge first"
	[[ "$draft" == false ]] || die "PR #$pr is a draft"
	if [[ "$labels" == *,needs-review,* ]]; then held+=("PR #$pr has the needs-review label"); fi
	[[ "$mergeable" != CONFLICTING ]] || die "PR #$pr conflicts with main: rebase it on main"
	[[ "$mergeable" == MERGEABLE ]] || die "PR #$pr isn't mergeable yet ($mergeable). Try again in a minute"
	# The checks vouch for the merge when they ran on code that has all of
	# main in it: a squash merge then gives main exactly the tree they tested.
	# A PR behind main merges too if main hasn't changed any of its files since
	# it branched, so parallel PRs don't rebase and rerun CI for each other.
	# What's left, a change in one file breaking code in another, shows in
	# main's own CI, and is fixed forward (OIK-234).
	git fetch -q "$rem" "refs/pull/$pr/head"
	if git merge-base --is-ancestor "$rem/main" "$oid"; then
		[[ "$(git rev-parse "$oid^{tree}")" != "$(git rev-parse "$rem/main^{tree}")" ]] || die "PR #$pr changes nothing on top of main"
	else
		overlap=$(main_overlap "$rem/main" "$oid") || die "PR #$pr changes nothing since it branched from main"
		[[ -z "$overlap" ]] ||
			die "PR #$pr is behind main, and main has since changed files it changes too: $(paste -sd' ' - <<<"$overlap"). Rebase it on main, push, and wait for its checks"
		behind=1
	fi
	checks=$(gh pr checks "$pr" --json workflow,name,bucket -q '.[] | "\(.bucket)\t\(.workflow)\t\(.name)"' || true)
	for workflow in Tests Lint; do
		grep -qE "^[a-z]+"$'\t'"$workflow"$'\t' <<<"$checks" ||
			die "PR #$pr has no $workflow checks yet. Wait with: gh pr checks $pr --watch"
	done
	# Held for the user, because they labelled the PR or its feature
	# needs-review: it merges only once their Approve covers the code as it is
	# now. That's read from the reviews, not the Approved by the owner
	# check, and by main's hack/owner-approval, not this worktree's, since
	# the PR could change either. It's asked before the checks, which fail
	# until the user approves, so the refusal says what it's waiting for.
	local label=agent-merged note="Merged by an agent: its checks passed on top of main, and nobody asked to review it first (docs/planning.md). Review it whenever you like, and remove the \`agent-merged\` label once you have."
	if (( ${#held[@]} )); then
		git cat-file -e "$REMOTE/main:hack/owner-approval" 2>/dev/null ||
			die "$(printf '%s\n' "${held[@]}")"$'\n'"and main has no hack/owner-approval yet, so the user merges it"
		approval=$(OWNER="${HOME_REPO%%/*}" PLAN_REMOTE="$rem" bash <(git show "$REMOTE/main:hack/owner-approval") "$pr" "$oid" main) ||
			die "$(printf '%s\n' "${held[@]}")"$'\n'"so it merges once the user approves it: ${approval:-hack/owner-approval said nothing}"
		label="" note="Merged by an agent on your Approve: $approval. Its checks passed on top of main (docs/planning.md)."
	fi
	local older="hecks passed on an older main, which hasn't touched its files since"
	if [[ -n "$behind" ]]; then note="${note/hecks passed on top of main/$older}"; fi
	failing=$(grep -vE '^(pass|skipping)'$'\t' <<<"$checks" || true)
	[[ -z "$failing" ]] || die "PR #$pr's checks haven't all passed:"$'\n'"$failing"
	# Label first, so a merged PR can't be missing it. The sha merges exactly
	# what the checks ran on.
	if [[ -n "$label" ]]; then add_pr_label "$pr" "$label"; fi
	if ! err=$(squash_merge "$pr" "$oid"); then
		if [[ -n "$label" ]]; then remove_pr_label "$pr" "$label" || true; fi
		die "couldn't merge PR #$pr: $err"
	fi
	gh_comment "$pr" "$note" || true
	on_repo ""
	cmd_sync "$n" >/dev/null
	restack "$n"
	if [[ -n "$behind" ]]; then behind=", behind main, which hadn't touched its files"; fi
	echo "Merged PR #$pr${label:+ (labelled $label)}$behind"
}

# main_overlap MAIN HEAD: the files both HEAD and MAIN changed since HEAD
# branched from MAIN, one a line. It fails if HEAD changes nothing.
main_overlap() {
	local mb ours
	mb=$(git merge-base "$1" "$2")
	# --no-renames lists both sides of a move, so a file moved on either side counts.
	ours=$(git diff --no-renames --name-only "$mb" "$2")
	[[ -n "$ours" ]] || return 1
	comm -12 <(sort <<<"$ours") <(git diff --no-renames --name-only "$mb" "$1" | sort)
}

# squash_merge PR SHA: squash-merge the PR at SHA. Labelling a PR reruns
# Approved by the owner, and GitHub refuses a merge while a required check is
# running, so that refusal is retried until the run ends. It prints GitHub's
# last error if it fails.
squash_merge() {
	local i err
	for ((i = 1; ; i++)); do
		err=$(as_agent api -X PUT "repos/$(repo)/pulls/$1/merge" -f merge_method=squash -f sha="$2" 2>&1 >/dev/null) && return 0
		case "$err" in
		*"Required status check"*"is expected"* | *"Required status check"*"is queued"* | *"Required status check"*"in progress"*)
			((i < MERGE_TRIES)) || break
			;;
		*) break ;;
		esac
		sleep "$MERGE_SLEEP"
	done
	echo "$err"
	return 1
}

# repo init OWNER/NAME: give an empty repo, such as a new plugin's, a main to
# build steps on: one commit with a README, as oikade-agent[bot]. The user
# creates the repo and gives the oikade-agent App access to it.
cmd_repo() {
	local sub="${1:-}" r="${2:-}" empty
	[[ "$sub" == init && -n "$r" ]] || die "usage: plan repo init OWNER/NAME"
	[[ "$r" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "\"$r\" isn't OWNER/NAME"
	empty=$(gh repo view "$r" --json isEmpty -q .isEmpty) || die "couldn't read $r. Create it first: gh repo create $r --public"
	[[ "$empty" == true ]] || die "$r isn't empty, so it already has a main to build on"
	as_agent api -X PUT "repos/$r/contents/README.md" -f message="chore: start the repo" \
		-f content="$(printf '# %s\n' "${r#*/}" | base64)" >/dev/null ||
		die "couldn't commit to $r as oikade-agent[bot]. The user gives the oikade-agent App access to it"
	echo "Started $r with a README on main"
}

cmd_restack() { restack "$(id "${1:?usage: plan restack ID}")"; }

cmd_release() {
	local n force="${2:-}" ahead
	n=$(id "${1:?usage: plan release ID}")
	git fetch -q "$REMOTE" main "+refs/heads/claim/$n:refs/remotes/$REMOTE/claim/$n" 2>/dev/null || die "$n isn't claimed"
	# Commits beyond the claim commit are real work.
	ahead=$(git rev-list --count "$REMOTE/main..$REMOTE/claim/$n")
	if [[ "$force" != --force ]] && (( ahead > 1 )); then
		die "claim/$n has $((ahead - 1)) commit(s) of work. Deleting it drops them from GitHub. To do it anyway: hack/plan release $n --force"
	fi
	git push -q "$REMOTE" --delete "claim/$n" || die "couldn't delete branch claim/$n"
	[[ "$(issue "$n" | jq -r .state.name)" != "In Progress" ]] || set_state "$n" "Todo"
	comment "$n" "Released the claim on \`claim/$n\`."
	echo "Released $n"
}

cmd_digest() {
	local days="${1:-7}" since r
	[[ "$days" =~ ^[0-9]+$ ]] || die "usage: plan digest [DAYS]"
	since=$(date -u -v-"${days}"d +%F 2>/dev/null || date -u -d "$days days ago" +%F)
	# This repo, then each other repo a step was built in: its remote is plan-*.
	for r in "$(repo)" $(other_repos); do
		GH_REPO="$r" gh pr list --state merged --limit 200 --search "label:agent-merged merged:>=$since" \
			--json number,title,url,mergedAt,additions,deletions,files \
			-q 'sort_by(.mergedAt)[] | "\(.mergedAt[:10])  #\(.number) \(.title)  (+\(.additions)/-\(.deletions), \([.files[].path | split("/")[0:2] | join("/")] | unique | join(" ")))\n    \(.url)"'
	done
}

# other_repos: OWNER/NAME of each other repo hack/plan has built a step in,
# from the plan-* remotes remote_for added.
other_repos() {
	local name
	for name in $(git remote | grep '^plan-' || true); do
		git remote get-url "$name" | sed -E 's#\.git$##; s#^.*[:/]([^/:]+/[^/:]+)$#\1#'
	done
}

cmd_claims() {
	local n json last age refs prs s i type repo title rem name others pr st
	git fetch -q --prune "$REMOTE" '+refs/heads/claim/*:refs/remotes/'"$REMOTE"'/claim/*' '+refs/heads/work/*:refs/remotes/'"$REMOTE"'/work/*' || true
	for name in $(git remote | grep '^plan-' || true); do
		git fetch -q --prune "$name" '+refs/heads/work/*:refs/remotes/'"$name"'/work/*' || true
	done
	prs=$(gh pr list --state open --limit 200 --json number,headRefName,isDraft)
	for n in $(claimed_ids); do
		json=$(issue "$n")
		refs=("refs/remotes/$REMOTE/claim/$n") others=""
		while IFS=$'\t' read -r i s type repo title; do
			if [[ "$repo" == - ]]; then
				refs+=("refs/remotes/$REMOTE/work/$s")
				continue
			fi
			# A step in another repo: its branch is under that repo's remote, and
			# its PR is looked up there.
			rem=$(remote_for "$repo") || exit 1
			refs+=("refs/remotes/$rem/work/$s")
			IFS=$'\t' read -r pr st _ <<<"$(step_pr "$s" "$repo")"
			if [[ "$st" == OPEN ]]; then others+=" $repo#$pr"; fi
		done < <(steps "$json")
		last=$(git for-each-ref --sort=-committerdate --count=1 --format='%(committerdate:unix)' "${refs[@]}")
		age=$(( ($(date +%s) - ${last:-0}) / 3600 ))
		printf '%s\t%sh since last commit\t%s%s\n' "$n" "$age" \
			"$(jq -r --arg re "^work/($(steps "$json" | cut -f2 | paste -sd'|' -))$" --arg others "${others# }" '[.[] | select(.headRefName | test($re)) | "#\(.number)\(if .isDraft then " draft" else "" end)"] + ($others | split(" ") | map(select(. != ""))) | if length > 0 then join(" ") else "no PR" end' <<<"$prs")" \
			"$(if (( age >= STALE_HOURS )); then echo $'\tSTALE'; fi)"
	done
}

# merged_to_main PR BASE: whether a merged PR's change has reached main, either
# directly or through the step below it.
merged_to_main() {
	[[ "$2" == main ]] && return 0
	[[ "$(gh pr list --head "$2" --state merged --json baseRefName -q '.[0].baseRefName // empty')" == main ]]
}

cmd_sync() {
	local ids n json claimed i s type repo title pr st base oid open k
	if [[ $# -gt 0 ]]; then ids=$(id "$1"); else
		count_issues
		ids=$(lin 'query($t: String!) { issues(first: 250, filter: {team: {key: {eq: $t}}, parent: {null: true},
			state: {type: {eq: "started"}}}) { nodes { identifier } } }' "$(jq -cn --arg t "$TEAM" '{t: $t}')" |
			jq -r '.issues.nodes[].identifier')
	fi
	claimed=" $(claimed_ids | tr '\n' ' ') "
	for n in $ids; do
		json=$(issue "$n")
		open=0
		while IFS=$'\t' read -r i s type repo title; do
			IFS=$'\t' read -r pr st base oid <<<"$(step_pr "$s" "$repo")"
			if [[ "$st" == MERGED ]] && GH_REPO="$([[ "$repo" == - ]] && echo "$HOME_REPO" || echo "$repo")" merged_to_main "$pr" "$base"; then
				if [[ "$type" != completed ]]; then
					k=$(line_step "$s")
					if [[ -n "$k" ]]; then
						tick "$n" "$k" && echo "$n: ticked step $k, PR #$pr merged"
					elif [[ "$s" != "$n" ]]; then
						set_state "$s" Done && echo "$s: done, PR #$pr merged"
					fi
				fi
				continue
			fi
			# Merged into the step below it, or open: not done, whatever Linear says.
			if [[ "$st" != MERGED && ( "$type" == completed || "$type" == canceled ) ]]; then continue; fi
			open=1
			if [[ "$st" == OPEN && "$type" != started ]] && sub_issue "$s" "$n"; then set_state "$s" "In Review" && echo "$s: in review, PR #$pr"; fi
		done < <(steps "$json")
		if (( open == 0 )); then
			set_state "$n" Done && echo "$n: done, every step merged"
		elif [[ "$(jq -r .state.name <<<"$json")" == "In Progress" && "$claimed" != *" $n "* ]]; then
			set_state "$n" Todo && echo "$n: back to Todo, nobody claims it"
		fi
	done
}

cmd_note() {
	local t="${1:?usage: plan note ID|PR TEXT}"
	shift
	if [[ "${t#\#}" =~ ^[0-9]+$ || "$t" == */*#* ]]; then
		pr_ref "$t"
		gh_comment "$PR_NUM" "$*"
		echo "Commented on PR $t"
	else
		t=$(id "$t")
		comment "$t" "$*"
		echo "Commented on $t"
	fi
}

# may_move ID STATE: why an agent may not move ID to STATE, or nothing.
may_move() {
	local cur a
	cur=$(issue "$1" | jq -r .state.name) || exit 1
	[[ "$cur" != "$DESIGN_REVIEW" ]] || { echo "only the user moves an issue out of $DESIGN_REVIEW: that's their approval"; return; }
	case "$(tr '[:upper:]' '[:lower:]' <<<"$2")" in
	todo | "in progress")
		a=$(approval "$1") || exit 1
		[[ -z "$a" || "$a" == approved* ]] || echo "$1 has been in $DESIGN_REVIEW, so only the user's move makes it buildable"
		;;
	esac
}

cmd_issue() {
	local title="${1:?usage: plan issue TITLE BODY_FILE [--state S] [--project P] [--parent ID] [--label L]...}" file="${2:?usage: plan issue TITLE BODY_FILE ...}"
	local in st="Backlog" parent="" project="" labels=()
	shift 2
	need_file "$file"
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--state) st="${2:?--state needs a status}"; shift 2 ;;
		--project) project="${2:?--project needs a name}"; shift 2 ;;
		--parent) parent=$(id "${2:?--parent needs an ID}"); shift 2 ;;
		--label) labels+=("$(label_id "${2:?--label needs a name}")"); shift 2 ;;
		*) die "unknown option $1" ;;
		esac
	done
	in=$(jq -cn --arg t "$(team_id)" --arg title "$title" --rawfile d "$file" --arg s "$(state_id "$st")" \
		'{teamId: $t, title: $title, description: $d, stateId: $s}')
	if [[ -n "$parent" ]]; then
		# A feature with any sub-issue takes its steps from them alone.
		[[ -z "$(issue "$parent" | jq -r '.description // ""' | checklist_lines)" ]] ||
			die "$parent's steps are lines in its ## Steps checklist, which a sub-issue would hide. Add the step as a line with hack/plan edit, or make every one of its steps a sub-issue"
		echo "plan: a step is usually a line in $parent's ## Steps checklist. A sub-issue is for a step that needs its own discussion, or is built in another repo" >&2
		in=$(jq -c --arg p "$(issue "$parent" | jq -r .id)" '. + {parentId: $p}' <<<"$in")
		[[ -n "$project" ]] || project=$(issue "$parent" | jq -r '.project.name // empty')
	fi
	[[ -z "$project" ]] || in=$(jq -c --arg p "$(project_id "$project")" '. + {projectId: $p}' <<<"$in")
	(( ${#labels[@]} )) && in=$(jq -c --args '. + {labelIds: $ARGS.positional}' "${labels[@]}" <<<"$in")
	lin 'mutation($in: IssueCreateInput!) { issueCreate(input: $in) { issue { identifier } } }' \
		"$(jq -cn --argjson in "$in" '{in: $in}')" | jq -r .issueCreate.issue.identifier
}

# above_steps: a description up to its "## Steps" heading, which is the design.
above_steps() { awk '/^##[ \t]+Steps[ \t]*$/ {exit} {print}'; }

# edit ID FILE: once the user has approved a design, it's what they decided,
# so only ## Steps and below may change.
cmd_edit() {
	local n file="${2:?usage: plan edit ID BODY_FILE}" a cur old
	n=$(id "${1:?usage: plan edit ID BODY_FILE}")
	need_file "$file"
	a=$(approval "$n")
	cur=$(issue "$n" | jq -r '.description // ""')
	if [[ "$a" == approved* ]] && [[ "$(above_steps <<<"$cur")" != "$(above_steps <"$file")" ]]; then
		die "$n's design is approved, so it's the user's decision: only ## Steps and below may change. Ask the user in a comment instead"
	fi
	# A checklist step is its position: its branch, PR and tick follow line k.
	old=$(checklist_lines <<<"$cur" | cut -f2)
	if [[ -n "$old" && "$(checklist_lines <"$file" | cut -f2 | head -n "$(grep -c . <<<"$old")")" != "$old" ]]; then
		die "$n's steps are numbered by their place in ## Steps, and their branches and PRs with them: keep the lines it has, in order and as worded, and add new ones at the end. Tick one that's no longer needed rather than removing it"
	fi
	update_issue "$n" "$(jq -cn --rawfile d "$file" '{description: $d}')"
	echo "Edited $n"
}

cmd_state() {
	local n st="${2:?usage: plan state ID STATE}" why
	n=$(id "${1:?usage: plan state ID STATE}")
	why=$(may_move "$n" "$st")
	[[ -z "$why" ]] || die "$why"
	set_state "$n" "$st"
	echo "$n: $st"
}

cmd_title() {
	local n t="${2:?usage: plan title ID TITLE}"
	n=$(id "${1:?usage: plan title ID TITLE}")
	update_issue "$n" "$(jq -cn --arg t "$t" '{title: $t}')"
	echo "$n: $t"
}

cmd_label() {
	local t="${1:?usage: plan label ID|PR +LABEL|-LABEL...}" l why add=() remove=() i
	shift
	[[ $# -gt 0 ]] || die "usage: plan label ID|PR +LABEL|-LABEL..."
	for l in "$@"; do
		[[ "$l" =~ ^[+-].+ ]] || die "say +$l to add it or -$l to remove it"
		why=$(label_refusal "${l:0:1}" "${l:1}")
		[[ -z "$why" ]] || die "$why"
		if [[ "$l" == +* ]]; then add+=("${l:1}"); else remove+=("${l:1}"); fi
	done
	if [[ "${t#\#}" =~ ^[0-9]+$ || "$t" == */*#* ]]; then
		pr_ref "$t"
		t="$PR_NUM"
		if (( ${#add[@]} )); then add_pr_label "$t" "${add[@]}"; fi
		for l in ${remove[@]+"${remove[@]}"}; do remove_pr_label "$t" "$l"; done
		echo "#$t: $*"
		return
	fi
	t=$(id "$t")
	i=$(issue "$t" | jq -r .id)
	for l in ${add[@]+"${add[@]}"}; do
		lin 'mutation($i: String!, $l: String!) { issueAddLabel(id: $i, labelId: $l) { success } }' \
			"$(jq -cn --arg i "$i" --arg l "$(label_id "$l")" '{i: $i, l: $l}')" >/dev/null
	done
	for l in ${remove[@]+"${remove[@]}"}; do
		lin 'mutation($i: String!, $l: String!) { issueRemoveLabel(id: $i, labelId: $l) { success } }' \
			"$(jq -cn --arg i "$i" --arg l "$(label_id "$l")" '{i: $i, l: $l}')" >/dev/null
	done
	echo "$t: $*"
}

cmd_block() {
	local n m
	n=$(id "${1:?usage: plan block ID BLOCKER}") m=$(id "${2:?usage: plan block ID BLOCKER}")
	lin 'mutation($in: IssueRelationCreateInput!) { issueRelationCreate(input: $in) { success } }' \
		"$(jq -cn --arg a "$(issue "$m" | jq -r .id)" --arg b "$(issue "$n" | jq -r .id)" '{in: {issueId: $a, relatedIssueId: $b, type: "blocks"}}')" >/dev/null
	echo "$n is blocked by $m"
}

cmd_projects() {
	lin '{ projects(first: 100) { nodes { name status { name } progress content description } } }' |
		jq -r '.projects.nodes | sort_by(.name)[]
			| "## \(.name) (\(.status.name // "-"), \(.progress * 100 | floor)% done)\n\(.content // .description // "")\n"'
}

cmd_project() {
	local sub="${1:-}" name file n s
	case "$sub" in
	new)
		name="${2:?usage: plan project new NAME FILE}" file="${3:?usage: plan project new NAME FILE}"
		need_file "$file"
		lin 'mutation($in: ProjectCreateInput!) { projectCreate(input: $in) { project { url } } }' \
			"$(jq -cn --arg n "$name" --arg t "$(team_id)" --rawfile c "$file" \
				'{in: {name: $n, teamIds: [$t], content: $c, description: ($c | capture("Goal: (?<g>[^\n]*)").g // "" | .[:255])}}')" |
			jq -r .projectCreate.project.url
		;;
	edit)
		name="${2:?usage: plan project edit NAME FILE}" file="${3:?usage: plan project edit NAME FILE}"
		need_file "$file"
		lin 'mutation($i: String!, $in: ProjectUpdateInput!) { projectUpdate(id: $i, input: $in) { success } }' \
			"$(jq -cn --arg i "$(project_id "$name")" --rawfile c "$file" '{i: $i, in: {content: $c}}')" >/dev/null
		echo "Edited $name"
		;;
	set)
		n=$(id "${2:?usage: plan project set ID NAME}") name="${3:?usage: plan project set ID NAME}"
		update_issue "$n" "$(jq -cn --arg p "$(project_id "$name")" '{projectId: $p}')"
		echo "$n is in $name"
		;;
	close)
		name="${2:?usage: plan project close NAME}"
		s=$(lin '{ projectStatuses { nodes { id type } } }' | jq -r '[.projectStatuses.nodes[] | select(.type == "completed")][0].id // empty')
		[[ -n "$s" ]] || die "Linear has no completed project status"
		lin 'mutation($i: String!, $in: ProjectUpdateInput!) { projectUpdate(id: $i, input: $in) { success } }' \
			"$(jq -cn --arg i "$(project_id "$name")" --arg s "$s" '{i: $i, in: {statusId: $s}}')" >/dev/null
		echo "Closed $name"
		;;
	rename)
		name="${2:?usage: plan project rename NAME NEW}" n="${3:?usage: plan project rename NAME NEW}"
		lin 'mutation($i: String!, $in: ProjectUpdateInput!) { projectUpdate(id: $i, input: $in) { success } }' \
			"$(jq -cn --arg i "$(project_id "$name")" --arg n "$n" '{i: $i, in: {name: $n}}')" >/dev/null
		echo "Renamed $name to $n"
		;;
	*) die "usage: plan project new NAME FILE | edit NAME FILE | set ID NAME | close NAME | rename NAME NEW" ;;
	esac
}

cmd_ideas() {
	lin 'query($t: String!) { issues(first: 250, filter: {team: {key: {eq: $t}}, state: {type: {eq: "triage"}}}) {
		nodes { identifier title project { name } } } }' "$(jq -cn --arg t "$TEAM" '{t: $t}')" |
		jq -r '.issues.nodes | sort_by(.identifier)[] | [.identifier, (.project.name // "-"), .title] | @tsv'
}

cmd_idea() {
	local title="${1:?usage: plan idea TITLE [BODY]}" f
	f=$(mktemp)
	printf '%s\n' "${2:-}" >"$f"
	cmd_issue "$title" "$f" --state Triage
	rm -f "$f"
}

cmd_promote() {
	local n st="${2:-Backlog}"
	n=$(id "${1:?usage: plan promote ID [STATE]}")
	[[ "$(issue "$n" | jq -r .state.type)" == triage ]] || die "$n isn't in Triage"
	cmd_state "$n" "$st"
}

# prime: fill the run-once caches in this shell. Most uses are in command
# substitutions, which can't fill them for later calls.
prime() {
	linear_auth
	states >/dev/null
	owner >/dev/null
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
	# Commands that write to GitHub mint the App token first, before anything
	# else, so a missing key stops them before they touch GitHub. Linear's
	# token comes with the first Linear call (lin), which is always before a
	# Linear write, and note and label on a PR never need it.
	claim | step | pr | merge | restack | release | sync | note | label | repo)
		agent_token
		HOME_REPO=$(repo) REPO="$HOME_REPO"
		export GH_REPO="$HOME_REPO"
		# note and label on a PR, and repo, never need Linear.
		if [[ "$cmd" != repo ]] && { [[ "$cmd" != note && "$cmd" != label ]] || [[ ! "${1#\#}" =~ ^([0-9]+|.*/.*#[0-9]+)$ ]]; }; then prime; fi
		"cmd_$cmd" "$@"
		;;
	digest) "cmd_$cmd" "$@" ;;
	ready | show | claims | issue | edit | title | state | block | projects | project | ideas | idea | promote)
		prime
		HOME_REPO=$(repo) REPO="$HOME_REPO"
		export GH_REPO="$HOME_REPO"
		"cmd_$cmd" "$@"
		;;
	help | -h | --help) usage ;;
	*) usage >&2; exit 2 ;;
esac
